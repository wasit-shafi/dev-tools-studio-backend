{
	"name": "dev-tools-studio",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"build": "npx tsc && copyfiles --error -f src/config/swagger/*.* dist/config/swagger && copyfiles --error -f src/templates/*.* dist/templates && copyfiles --error -f src/public/favicon.* dist/public",
		"build:d4r": "docker build -t wasitshafi700/dev-tools-studio-backend:latest .",
		"tsnd": "ts-node-dev --files -r tsconfig-paths/register --env-file=src/config/environment/dev.env src/index.ts",
		"dev": "ts-node-dev --files -r tsconfig-paths/register src/index.ts",
		"start": "node -r tsconfig-paths/register dist/index.js",
		"up": "docker-compose up --build -V --watch",
		"up:prod": "docker-compose -f docker-compose.prod.yml up --build -V",
		"down": "docker-compose down --remove-orphans",
		"down:prod": "docker-compose -f docker-compose.prod.yml down --remove-orphans",
		"format-codebase": "npx prettier --write .",
		"secrets-list": "git secrets --list",
		"secrets-scan": "git secrets --scan",
		"secrets-scan-history": "git secrets --scan-history"
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.864.0",
		"@aws-sdk/s3-request-presigner": "^3.864.0",
		"@bull-board/express": "^6.12.1",
		"@types/multer": "^1.4.12",
		"@types/serve-favicon": "^2.5.7",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.58.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"ejs": "^3.1.10",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongodb": "^6.18.0",
		"mongoose": "^8.17.2",
		"morgan": "^1.10.1",
		"multer": "^2.0.2",
		"node-ipinfo": "^4.1.0",
		"nodemailer": "^7.0.5",
		"otp-generator": "^4.0.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"serve-favicon": "^2.5.1",
		"swagger-ui-express": "^5.0.1",
		"ua-parser-js": "^2.0.4",
		"uuid": "^11.1.0",
		"winston": "^3.17.0",
		"yaml": "^2.8.1",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^22.15.24",
		"@types/nodemailer": "^6.4.17",
		"@types/otp-generator": "^4.0.2",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ua-parser-js": "^0.7.39",
		"concurrently": "^9.2.0",
		"copyfiles": "^2.4.1",
		"eslint": "^9.33.0",
		"prettier": "^3.6.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.2"
	}
}
